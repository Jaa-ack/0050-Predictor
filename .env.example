# Copy to .env, chmod 0600 .env. NEVER put real values in this tracked example.
FINMIND_TOKEN=
FRED_API_KEY=
FMP_API_KEY=
NEWS_API_KEY=
TWINKLE_API_KEY=
FUGLE_API_KEY=
FUBON_API_KEY=
# Fubon API-key login still requires ID and local certificate (official SDK >=2.2.8 for adjusted candles).
FUBON_PERSONAL_ID=
FUBON_CERT_PATH=
FUBON_CERT_PASSWORD=
# Optional legacy password login; leave blank when using FUBON_API_KEY.
FUBON_PASSWORD=
